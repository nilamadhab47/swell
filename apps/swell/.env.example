EXPO_PUBLIC_API_URL=https://paisahipaisahoga-production.up.railway.app

# Required for Expo push notifications. Get it from `eas init` (or the Expo
# dashboard). Without it, getExpoPushTokenAsync cannot mint a token.
EAS_PROJECT_ID=

# Optional path to Firebase google-services.json. Needed for Android push in a
# standalone APK (not Expo Go). Leave blank to ship without FCM for now.
GOOGLE_SERVICES_JSON=
